# Somente variáveis não sensíveis. Nenhum segredo no frontend.

# Base da API no navegador. "/api" usa o rewrite do Next (same-origin, recomendado).
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Endereço do NestJS visto pelo servidor Next (destino do rewrite). Não vai para o navegador.
BACKEND_INTERNAL_URL=http://localhost:3333

# Mostra "Continuar com Google" (o backend precisa de GOOGLE_CLIENT_ID/SECRET).
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=true
