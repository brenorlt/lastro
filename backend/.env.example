# ───────────── Lastro API — variáveis de ambiente ─────────────
# Copie para .env e ajuste. NUNCA versione o .env com segredos reais.

# development | staging | production | test
NODE_ENV=development
PORT=3333
# URL pública do app web (frontend). Usada nos links de e-mail e como origem
# confiável na proteção CSRF de /auth/refresh e /auth/logout.
APP_URL=http://localhost:3100

# PostgreSQL (docker compose expõe na porta 5433 do host)
DATABASE_URL=postgresql://lastro:lastro@localhost:5433/lastro?schema=public
# Conexão DIRETA (sem pooler) para `prisma migrate deploy` — em dev local é a mesma
# do DATABASE_URL; em produção com Neon, use o host SEM "-pooler" (senão migrate
# deploy trava com P1002 tentando pegar o advisory lock via PgBouncer).
DIRECT_URL=postgresql://lastro:lastro@localhost:5433/lastro?schema=public

# JWT — gere com: openssl rand -hex 32  (mínimo 32 caracteres, valores diferentes)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Origens permitidas para CORS (lista separada por vírgula)
CORS_ORIGINS=http://localhost:3100

# Rate limiting global: THROTTLE_LIMIT requisições a cada THROTTLE_TTL milissegundos
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Swagger em /api/docs — sempre ativo fora de produção; em produção só se true
SWAGGER_ENABLED=false

# Número de proxies reversos confiáveis à frente da API (afeta req.ip, rate limit e o IP
# gravado nas sessões). O frontend Next faz proxy de /api/* → use 1 (Next) ou 2 (Next + LB).
TRUST_PROXY=1

# Limite do corpo das requisições (formato do body-parser)
BODY_LIMIT=1mb

# Hash de senha Argon2id (Fase 2) — memória em KiB, iterações e paralelismo
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Bloqueio contra força bruta (Fase 2)
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Exigir e-mail confirmado para entrar (padrão true). Desligado temporariamente:
# o link continua sendo enviado, mas o login não depende dele.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Cookies de sessão (lastro_rt / lastro_session). Deixe vazio para usar o host atual.
COOKIE_DOMAIN=

# E-mail: "log" (dev/test — registra assunto e link no log), "resend" (produção, via
# resend.com) ou "smtp" (ainda não implementado)
MAIL_TRANSPORT=log
MAIL_FROM="Lastro <nao-responda@lastrofinance.com>"
# Obrigatório com MAIL_TRANSPORT=smtp (ex.: smtp://usuario:senha@smtp.exemplo.com:587)
SMTP_URL=
# Obrigatório com MAIL_TRANSPORT=resend — gere em resend.com/api-keys. O domínio usado em
# MAIL_FROM precisa estar verificado na conta Resend (resend.com/domains).
RESEND_API_KEY=

# Diretório local para uploads (avatares em <UPLOAD_DIR>/avatars). Em Docker, use um volume.
UPLOAD_DIR=./storage

# Cobrança (AbacatePay) — crie a conta em app.abacatepay.com e gere a chave em
# Integrar → API Keys. ABACATEPAY_WEBHOOK_SECRET é escolhido por você (string forte
# qualquer) e usado ao registrar o webhook em POST /webhooks/create.
ABACATEPAY_API_KEY=change-me-abacatepay-api-key
ABACATEPAY_BASE_URL=https://api.abacatepay.com/v2
ABACATEPAY_WEBHOOK_SECRET=change-me-abacatepay-webhook-secret-32-chars
# Reservado para quando o checkout por produto/plano fixo for implementado (ainda não lido pelo código).
ABACATEPAY_PRODUCT_ID=change-me-abacatepay-product-id
# Dias de teste grátis no cadastro e preço do plano único (em centavos)
BILLING_TRIAL_DAYS=7
BILLING_PLAN_PRICE_CENTS=2500
# Dias de antecedência do e-mail de "acesso prestes a vencer" (trial ou período pago)
BILLING_EXPIRY_NOTICE_DAYS=3
